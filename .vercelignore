# Monorepo — keep backend/app and shared/ in the upload. The Python
# functions import that package; a broad /backend/* ignore drops it even
# when a later rule tries to put it back.
/backend/.venv/
/backend/tests/
/backend/.pytest_cache/
/backend/.local-test-tmp/
/database/
/docs/
/all websites/
/android-twa/
/actions-runner/
/.agents/
/.cursor/
/.github/
/agent-transcripts/

# Python / local tooling (backend venv is ~130MB)
**/.venv/
**/__pycache__/
*.py[cod]

# Tests & dev artifacts
frontend/coverage/
frontend/dist-e2e/
frontend/e2e/

# Large generated snapshots (rebuilt during `npm run build` on Vercel)
frontend/public/data/job-details/
frontend/public/data/official-feed-items.json

# Dependencies & build caches (Vercel installs fresh)
node_modules/
frontend/node_modules/
.vite/
dist/
frontend/dist/

# Secrets & local config
.env
.env.*
!.env.example
!frontend/.env.example
!backend/.env.example
.vercel/

# Git & editor noise
.git/
.idea/
*.swp
.DS_Store
