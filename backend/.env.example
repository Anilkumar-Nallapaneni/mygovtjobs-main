# Backend — copy to backend/.env
APP_ENV=development
ALLOW_INSECURE_ADMIN=1

# Supabase transaction pooler (port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Admin API key for ingest and /api/admin routes
ADMIN_API_KEY=long-random-string

# Optional: alert delivery
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: rate limiting at scale
REDIS_URL=

# Optional: PDF OCR for scanned notifications
PDF_OCR_ENABLED=0
