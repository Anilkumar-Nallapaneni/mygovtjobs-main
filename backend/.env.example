# Backend — copy to backend/.env
APP_ENV=development
ALLOW_INSECURE_ADMIN=1

# Supabase transaction pooler (port 6543)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Admin API key for ingest and /api/admin routes
ADMIN_API_KEY=long-random-string

# Production freeze: keep 0 until publish gate + scrub are stable (1 = auto-live verified recruitments)
AUTO_PUBLISH_VERIFIED=0

# Never merge draft/unverified rows into frontend/public/data/live-jobs.json (dev override only)
ALLOW_FALLBACK_JSON_EXPORT=0

# Optional: alert delivery
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: rate limiting at scale
REDIS_URL=

# Optional: PDF OCR for scanned notifications
PDF_OCR_ENABLED=0

# Optional: AI QA employee (LLM assist). Deterministic extractors always run;
# LLM only confirms fields already supported by notice text.
# OPENAI_API_KEY=
# AI_REVIEW_API_KEY=
# AI_REVIEW_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Cloudflare Turnstile secret (fail-closed in APP_ENV=production when unset)
TURNSTILE_SECRET_KEY=
