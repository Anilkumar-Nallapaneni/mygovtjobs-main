# Root workspace — optional overrides for scripts/CI
VITE_SITE_URL=https://www.livegovtjobs.com
ALERT_SITE_URL=https://www.livegovtjobs.com
PRERENDER_JOB_LIMIT=5000

# Same-origin India function: frontend VITE_API_URL stays empty.
# Configure DATABASE_URL on the server only, never as VITE_* (transaction pooler :6543).
# DATABASE_SSL_CA_FILE may point to an additional trusted CA file if needed.
# Do not copy database credentials into frontend/.env.local or commit them.
