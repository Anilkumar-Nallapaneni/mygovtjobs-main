{
  "name": "mygovtjobs-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
   },
  "scripts": {
    "dev": "vite",
    "fetch:official": "node ../scripts/fetch-all-official.mjs",
    "fetch:official:rss": "node ../scripts/fetch-official-feeds.mjs",
    "fetch:official:sites": "node ../scripts/fetch-official-sites.mjs",
    "i18n:generate": "node scripts/generate-locale-overrides.mjs",
    "i18n:fill": "node scripts/fill-locale-flats.mjs",
    "i18n:audit": "node scripts/audit-locale-flats.mjs",
    "i18n:sync": "npm run i18n:generate",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && npx tsc -p tsconfig.build.json && node ../scripts/build-sitemap.mjs && node ../scripts/build-live-jobs-list.mjs && node ../scripts/build-live-jobs-bootstrap.mjs && node ../scripts/verify-live-jobs-snapshot.mjs --strict && vite build && node ../scripts/prerender-job-pages.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "serve": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "playwright:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "vercel:env:push": "npm run vercel:env:push --prefix ..",
    "vercel:deploy": "npm run vercel:deploy --prefix .."
  },
  "dependencies": {
    "@fontsource/sora": "^5.2.8",
    "@sentry/react": "^9.30.0",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-virtual": "^3.13.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "i18next": "^26.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
