# Frontend — copy to frontend/.env.local
# VITE_SITE_URL is the prerender/fallback origin. In the browser, each host
# (www.livegovtjobs.com and www.govtjobs.me) uses window.location.origin.
VITE_SITE_URL=https://www.livegovtjobs.com
VITE_DAILY_SYNC_ONLY=0

# Homepage catalog is always the CDN/static live-jobs.json snapshot.
# VITE_JOBS_SOURCE still affects job detail / search fallbacks (supabase|api|auto|static).
VITE_JOBS_SOURCE=static

# Supabase (optional for static-only dev — uses committed live-jobs.json)
VITE_SUPABASE_URL=https://YOUR_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Optional API (FTS search when set)
VITE_API_URL=

# Launch flags (keep billing/admin UI off until verified)
VITE_ENABLE_BILLING=0
VITE_ENABLE_ADMIN_UI=0

# Analytics & SEO
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GOOGLE_SITE_VERIFICATION=your-search-console-token

# Web push (optional)
VITE_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile (optional — alerts/contact/report when API is live)
VITE_TURNSTILE_SITE_KEY=

# Social links (optional overrides)
VITE_SOCIAL_TELEGRAM_URL=
VITE_SOCIAL_YOUTUBE_URL=
VITE_SOCIAL_X_URL=
VITE_SOCIAL_INSTAGRAM_URL=
